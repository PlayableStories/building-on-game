{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /**
     * Deliberately empty. The game ships to a browser, so nothing here should
     * see Node's globals or a test runner's. `process.env` and a stray
     * `describe(...)` are both compile errors in this project, which is the
     * point — before this split they typechecked in component code.
     */
    "types": [],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
