    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "tsx scripts/validate.ts",
    "screenshots": "npm run build && tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
